      "connect": {"claude": ["claude mcp add --transport http higgsfield https://mcp.higgsfield.ai/mcp"],
                  "codex": ["codex mcp add higgsfield --url https://mcp.higgsfield.ai/mcp", "codex mcp login higgsfield"]},
      "auth": "oauth", "free": "по тарифу аккаунта; потолок траты — параметр max_credits", "docs": "https://higgsfield.ai",
