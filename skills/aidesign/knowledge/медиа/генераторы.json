  "generic": {
    "match": ["^mcp__[^_].*__(generate|gen|create|make|run|text|image)_?(to_)?(image|images|img|video|videos|audio|speech|music|sound|sfx|3d|model3d|mesh|svg|vector)s?\\b",
              "^mcp__[^_].*__(images|image|video|videos|audio|models3d|model3d|music|speech)_(generate|create)",
              "^mcp__[^_].*__(txt2img|img2img|img2vid|txt2vid|text2image|text2video)"],
    "kinds": {"image": "image|img|txt2img|picture|photo", "video": "video|vid|animate", "audio": "audio|speech|music|sound|sfx|voice",
              "3d": "3d|mesh|glb", "vector": "vector", "svg": "svg"},
    "roles": {"generate": "generat|create_(image|video|audio|3d|mesh|svg)|text_to_|image_to_|txt2|img2|run_model|_generate$",
              "balance": "balance|credit|quota|subscription|usage",
              "price": "price|pricing|cost|estimate|preflight|simulate",
              "wait": "wait|status|poll|check_job|get_job|get_task|get_generation|result",
              "download": "download|get_job_result|read$"},
    "connect": {"claude": ["claude mcp add --transport http <имя> <URL>"],
                "codex": ["codex mcp add <имя> --url <URL>", "codex mcp login <имя>"]}
  }
